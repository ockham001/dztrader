{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "edit", "resource": "apps/ctp/md/*", "effect": "ask" },
    { "action": "shell", "resource": "cmake --build *", "effect": "deny" },
    { "action": "shell", "resource": "npm run build *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "ask" },
    { "action": "shell", "resource": "git push", "effect": "ask" },
    { "action": "shell", "resource": "git push origin main", "effect": "ask" },
    { "action": "shell", "resource": "git push origin main *", "effect": "ask" },
    { "action": "shell", "resource": "git push * main", "effect": "ask" },
    { "action": "shell", "resource": "git push * main *", "effect": "ask" },
    { "action": "shell", "resource": "git push * --delete*", "effect": "ask" },
    { "action": "shell", "resource": "git push --delete*", "effect": "ask" },
    { "action": "shell", "resource": "git push * --tags*", "effect": "ask" },
    { "action": "shell", "resource": "git push --tags*", "effect": "ask" },
    { "action": "shell", "resource": "git push * --prune*", "effect": "ask" },
    { "action": "shell", "resource": "git push --prune*", "effect": "ask" },
    { "action": "shell", "resource": "git push * :*", "effect": "ask" },
    { "action": "shell", "resource": "git push main", "effect": "ask" },
    { "action": "shell", "resource": "git push * *:main", "effect": "ask" },
    { "action": "shell", "resource": "git push * refs/tags/*", "effect": "ask" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push * -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push * --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push * +*", "effect": "deny" },
    { "action": "shell", "resource": "git push +*", "effect": "deny" },
    { "action": "shell", "resource": "git push --mirror*", "effect": "deny" },
    { "action": "shell", "resource": "git push * --mirror*", "effect": "deny" },
    { "action": "shell", "resource": "git -C * push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git -C * push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git -C * push * -f*", "effect": "deny" },
    { "action": "shell", "resource": "git -C * push * --force*", "effect": "deny" }
  ]
}
