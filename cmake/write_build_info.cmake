# write_build_info.cmake — 生成 BUILD_INFO（构建身份，#515）
#
# 由 CMakeLists.txt 的 `dz_build_info` custom target 以 `cmake -P` **脚本模式**在构建期
# 调用，不在 configure 期生成：commit / dirty / 构建时间都是「构建那一刻」的事实，而
# configure 只在 setup 时跑一次（HEAD 之后随时会变，这正是 #515 要解决的问题——产物
# 没有身份，只能靠 mtime 与 sha256sum 手工推断跑的是哪一版）。
#
# 输入（-D 传入）:
#   DZ_BI_OUT     输出文件路径（build/<plat>/<arch>/<cfg>/BUILD_INFO）
#   DZ_BI_REPO    仓库根（git -C 用；可以是任意目录，不是 git 仓库时身份记为 unknown）
#   DZ_BI_GIT     git 可执行文件（可缺省，缺省时同 PATH 里的 git）
#   DZ_BI_VERSION 完整版本串（含 pre-release），如 0.1.0 / 0.1.0-rc1
#   DZ_BI_CONFIG  构建目录叶子名（Release / Debug / Asan）
#
# 输出格式（k=v 纯文本 + 一行注释；解析方是 scripts/check_build_info.py）:
#   commit=<40 位 sha，或 unknown>
#   dirty=<0|1|unknown>
#   built_at=<ISO 8601 UTC，如 2026-11-27T10:04:48Z>
#   version=<完整版本串>
#   config=<构建目录叶子名>
#
# 为什么 `dirty` 用 `git status --porcelain`（含未跟踪、不含 gitignore）：未提交/未跟踪的
# 源文件同样可能进了产物，与「工作区是否干净」同口径；build/、install/ 等产物目录已在
# .gitignore 中，不会被算成 dirty。

if(NOT DEFINED DZ_BI_OUT OR NOT DEFINED DZ_BI_REPO)
    message(FATAL_ERROR "write_build_info: DZ_BI_OUT and DZ_BI_REPO are required")
endif()

if(NOT DEFINED DZ_BI_GIT OR DZ_BI_GIT STREQUAL "")
    set(DZ_BI_GIT "git")
endif()
if(NOT DEFINED DZ_BI_VERSION)
    set(DZ_BI_VERSION "unknown")
endif()
if(NOT DEFINED DZ_BI_CONFIG)
    set(DZ_BI_CONFIG "unknown")
endif()

set(_commit "unknown")
set(_dirty "unknown")

execute_process(
    COMMAND "${DZ_BI_GIT}" -C "${DZ_BI_REPO}" rev-parse HEAD
    OUTPUT_VARIABLE _sha
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE _rc)
if(_rc EQUAL 0 AND _sha MATCHES "^[0-9a-f]+$")
    set(_commit "${_sha}")
    execute_process(
        COMMAND "${DZ_BI_GIT}" -C "${DZ_BI_REPO}" status --porcelain
        OUTPUT_VARIABLE _status
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE _rc)
    if(_rc EQUAL 0)
        if(_status STREQUAL "")
            set(_dirty "0")
        else()
            set(_dirty "1")
        endif()
    endif()
endif()

string(TIMESTAMP _built_at "%Y-%m-%dT%H:%M:%SZ" UTC)

get_filename_component(_out_dir "${DZ_BI_OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_out_dir}")
file(WRITE "${DZ_BI_OUT}"
    "# dztrader build identity | generated by the build, do not edit (#515)\n"
    "commit=${_commit}\n"
    "dirty=${_dirty}\n"
    "built_at=${_built_at}\n"
    "version=${DZ_BI_VERSION}\n"
    "config=${DZ_BI_CONFIG}\n")

message(STATUS
    "build info written | path=${DZ_BI_OUT} commit=${_commit} dirty=${_dirty} built_at=${_built_at}")
