# === Build artifacts ===

# Worktrees (must be before build dirs)
.worktrees/
# create_worktree 的实际产物路径（AGENTS §五「Worktree 与 Git 禁令」）。此前只靠未跟踪的
# .agents/worktrees/.gitignore 屏蔽，新克隆跑一次 create_worktree 就会把整个目录写进
# git status（#316 AC5）。
.agents/

.run/

# Compiled Object files
*.d
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Debug information
*.dwo
*.dwp

# === Build directories ===
build/
Build/
build-*/
out/
install/

# === CMake/Conan generated files ===
compile_commands.json
version.h
# 项目级 CMakePresets.json 已版本化（提交到 git）
# CMakeUserPresets.json 是用户私有（conan 生成或个人配置），忽略
CMakeUserPresets.json
# conan 生成的 toolchain（在 build/ 下，已被 build/ 覆盖）

# === IDE and editor files ===

# Visual Studio
.vs/
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.suo
*.ncb
*.sdf
*.opensdf
ipch/

# Visual Studio Code
# 注意：用 .vscode/* 而非 .vscode/，否则 ! 白名单无效
# （.vscode/ 带尾随 / 会排除整个目录，git 不进入扫描，! 无法重新包含）
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# CLion / JetBrains
.idea/

# Xcode
*.xcodeproj/
*.xcworkspace/

# === Project-specific ===
.dztrader_dev/
/tmp/

# 运行时数据目录（dzweb/master 生成，DZTRADER_HOME 指向仓库根时产生）
# 注意: 必须根锚定 (/), 否则会误吞同名源码目录 (如 libs/db、libs/shm）
# 配置文件一律由进程自动生成（如 webui.json/dztraderd.json），仓库不保留 example 模板
/configs/
/db/
/uploads/
/flow/
/cache/

# 运行时共享内存文件 (单文件序号只增不减, 定期删除旧文件)
/shm/
third_party/**/*.so
third_party/**/*.dll
third_party/**/*.lib
third_party/**/*.pdb
!third_party/ctp/**

# === OS files ===
.DS_Store
Thumbs.db

# === Temporary files ===
*.tmp
*.log
*.bak
*.swp
*~

# === Python ===
__pycache__/
*.py[cod]
*.egg-info/
dist/
*.whl

# === Web frontend ===
node_modules/

# === Test/cache ===
.cache/

# Playwright MCP 的会话产物（页面快照 / 控制台日志 / 截图）落在这里，
# 不是源码：浏览器工具每用一次就在仓库根生成一个新目录，不忽略即污染 git status。
.playwright-mcp/

# Agent 会话的临时工作目录（调研草稿 / 未发布 spec / 交付单）。
# 不属于仓库记忆：结论要落 docs/ 或 GitHub Issues，这里只放过程中的中间产物。
# 不忽略就会长期占着 git status（AGENTS §五「共享工作区只允许当前票的 WIP」）。
.scratch/

# Impeccable 的运行时目录（问题种子 / 变体预览 / 审查截图 / 屏幕稿 / 表面契约）。
# questions/ 自带 .gitignore 自我忽略；review/ 与 mocks/ 是本地取证产物，surfaces/ 是
# `impeccable surface-brief write` 每次整份重写的产物；三者每轮都会重写，提交只会制造噪音。
# **不要**整目录忽略 .impeccable/ —— PRODUCT.md、DESIGN.md、design.json 与 live/config.json
# 必须能被协作者和 worktree 看到。
.impeccable/review/
.impeccable/mocks/
.impeccable/surfaces/
.impeccable/config.local.json

# === Doxygen generated ===
docs/api/
