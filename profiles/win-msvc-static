# dztrader Windows 构建profile（静态 CRT）
# 用法: conan install . -pr:b profiles/win-msvc-static -pr:h profiles/win-msvc-static
#       Debug 变体: 追加 -s build_type=Debug -s compiler.runtime_type=Debug
[settings]
os=Windows
arch=x86_64
compiler=msvc
compiler.version=194
compiler.cppstd=20
compiler.runtime=static
compiler.runtime_type=Release
build_type=Release

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
# 禁用 conan 生成 CMakeUserPresets.json（空值=禁用）
# 项目根有版本化的 CMakePresets.json，conan 只负责生成 toolchain
tools.cmake.cmaketoolchain:user_presets=
