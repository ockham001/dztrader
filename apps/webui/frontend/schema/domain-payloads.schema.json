{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "domain-payloads",
  "title": "WS 领域载荷（前端单源 schema）",
  "description": "dzweb → 前端 WS 消息 data 的权威 schema。真源=帧契约（process/progress 等）。前端 src/types/generated.ts 由 scripts/gen-types.mjs 生成，禁止手改。新增/修改字段必须同步更新对应帧契约。",
  "$defs": {
    "ProcessState": {
      "type": "string",
      "enum": ["Starting", "Running", "Stopping", "Stopped", "Crashed"],
      "description": "进程状态（契约 process）"
    },
    "ProcessEvent": {
      "type": "string",
      "enum": ["StartSucceeded", "StartFailed", "StopSucceeded", "StopFailed", "RemoveSucceeded", "RemoveFailed"],
      "description": "进程操作结果事件（契约 process）"
    },
    "ProcessStatusPayload": {
      "type": "object",
      "required": ["name", "state", "pid"],
      "properties": {
        "name": { "type": "string", "description": "进程名" },
        "state": { "$ref": "#/$defs/ProcessState" },
        "pid": { "type": "integer", "description": "进程 PID，未运行时为 0" },
        "display_name": { "type": "string", "description": "用户可读显示名；缺省为空串" },
        "message": { "type": "string", "description": "状态说明/失败原因；缺省为空串" },
        "event": {
          "description": "操作结果事件；缺失或 null 均为自发状态变化（契约 webui-ws §2.2）",
          "anyOf": [{ "$ref": "#/$defs/ProcessEvent" }, { "type": "null" }]
        }
      }
    },
    "ProgressStatus": {
      "type": "object",
      "required": ["min", "max", "current"],
      "properties": {
        "min": { "type": "integer" },
        "max": { "type": "integer", "description": "max <= min（含 max==0）表示不确定进度" },
        "current": { "type": "integer" },
        "desc": { "type": "string", "description": "简短文本说明；空串/省略=无文本" }
      }
    },
    "LogConfigPayload": {
      "type": "object",
      "required": ["level", "flush_on"],
      "properties": {
        "level": { "type": "string", "description": "当前生效级别，始终为规范全称（契约 log）" },
        "flush_on": { "type": "string", "description": "当前生效 flush 阈值，始终为规范全称" }
      }
    },
    "AutoLoginSchedule": {
      "type": "object",
      "required": ["login_time", "logout_time"],
      "properties": {
        "login_time": { "type": "string", "description": "登录时间 HH:MM（进程本地时间）" },
        "logout_time": { "type": "string", "description": "登出时间 HH:MM（进程本地时间）" }
      }
    },
    "AutoLoginPayload": {
      "type": "object",
      "required": ["enabled", "schedules"],
      "properties": {
        "enabled": { "type": "boolean", "description": "是否启用自动登录排程" },
        "schedules": { "type": "array", "items": { "$ref": "#/$defs/AutoLoginSchedule" }, "description": "排程整体覆盖（契约 auto-login）" }
      }
    },
    "NotifyUiPayload": {
      "type": "object",
      "required": ["source", "level", "message", "timestamp", "popup"],
      "properties": {
        "source": { "type": "string", "description": "通知来源（进程名或策略 ID）" },
        "level": { "type": "string", "enum": ["info", "warning", "error"], "description": "通知级别" },
        "message": { "type": "string", "description": "通知正文" },
        "timestamp": { "type": "integer", "description": "Unix 秒级时间戳" },
        "popup": { "type": "boolean", "description": "是否弹窗打断用户" }
      }
    },
    "BrokerFrontend": {
      "type": "object",
      "required": ["address", "label", "enabled"],
      "properties": {
        "address": { "type": "string", "description": "前置地址，非空（契约 md-config）" },
        "label": { "type": "string", "description": "可选人类可读标签，可为空" },
        "enabled": { "type": "boolean", "description": "是否启用（注册到 CTP）" }
      }
    },
    "BrokerEntry": {
      "type": "object",
      "required": ["name", "broker_id", "user_id", "password", "product_info", "frontends"],
      "properties": {
        "name": { "type": "string", "description": "经纪商不可变 key" },
        "broker_id": { "type": "string", "description": "经纪公司代码" },
        "user_id": { "type": "string", "description": "用户代码" },
        "password": { "type": "string", "description": "登录密码（生产/RTN 脱敏为 ****）" },
        "product_info": { "type": "string", "description": "产品信息" },
        "frontends": { "type": "array", "items": { "$ref": "#/$defs/BrokerFrontend" }, "description": "前置地址列表" }
      }
    },
    "MdConfigPayload": {
      "type": "object",
      "required": ["brokers", "current_broker_name"],
      "properties": {
        "brokers": { "type": "array", "items": { "$ref": "#/$defs/BrokerEntry" }, "description": "经纪商列表（RTN 全量）" },
        "current_broker_name": { "type": "string", "description": "当前选中经纪商名，空或指向存在的经纪商" },
        "subscribe_batch_size": { "type": "integer", "description": "每批订阅数量" },
        "subscribe_batch_delay_ms": { "type": "integer", "description": "批间延迟（毫秒）" },
        "sub_check_interval_ms": { "type": "integer", "description": "补订检查间隔（毫秒）" },
        "sub_max_retry": { "type": "integer", "description": "补订最大重试" }
      }
    },
    "MdRtnConfigPayload": {
      "type": "object",
      "required": ["source", "config"],
      "properties": {
        "source": { "type": "string", "description": "行情源进程名" },
        "config": { "$ref": "#/$defs/MdConfigPayload", "description": "脱敏行情配置" }
      }
    },
    "PreloadPoint": {
      "type": "object",
      "required": ["pages", "bytes"],
      "properties": {
        "pages": { "type": "integer", "description": "预加载页数，范围 [0,8]" },
        "bytes": { "type": "integer", "description": "预加载字节数，范围 [0,2^40]" }
      }
    },
    "ShmConfigView": {
      "type": "object",
      "required": ["page_size_mb", "preload_points", "check_interval_min", "check_pages", "check_bytes"],
      "properties": {
        "page_size_mb": { "type": "integer", "description": "页大小（MB），启动后不可变" },
        "preload_points": { "type": "object", "additionalProperties": { "$ref": "#/$defs/PreloadPoint" }, "description": "预加载点，key=HH:MM" },
        "check_interval_min": { "type": "integer", "description": "周期检查间隔（分钟），0=不检查" },
        "check_pages": { "type": "integer", "description": "周期检查预加载页数" },
        "check_bytes": { "type": "integer", "description": "周期检查预加载字节数" }
      }
    },
    "LogLine": {
      "type": "object",
      "required": ["n", "ts", "level", "logger", "func", "file", "line", "pid", "tid", "msg", "raw", "parsed"],
      "properties": {
        "n": { "type": "integer", "description": "行号" },
        "ts": { "type": "string", "description": "时间戳" },
        "level": { "type": "string", "description": "日志级别" },
        "logger": { "type": "string", "description": "logger 名" },
        "func": { "type": "string", "description": "函数名" },
        "file": { "type": "string", "description": "源文件名" },
        "line": { "type": "integer", "description": "源文件行号" },
        "pid": { "type": "string", "description": "进程 ID" },
        "tid": { "type": "string", "description": "线程 ID" },
        "msg": { "type": "string", "description": "日志消息" },
        "raw": { "type": "string", "description": "原始行" },
        "parsed": { "type": "boolean", "description": "是否已结构化解析" }
      }
    },
    "MdRtnStatusPayload": {
      "type": "object",
      "required": ["source", "status"],
      "properties": {
        "source": { "type": "string", "description": "行情源进程名" },
        "status": { "type": "object", "additionalProperties": true, "description": "网关状态（结构随接口类型）" }
      }
    },
    "SysmonSamplingMeta": {
      "type": "object",
      "required": ["measure_interval_ms", "last_sample_unix_ms", "missed_ticks"],
      "properties": {
        "measure_interval_ms": { "type": "integer", "description": "当前计量间隔（毫秒）" },
        "last_sample_unix_ms": { "type": "integer", "description": "最近一次计量成功的 Unix 毫秒时间；0=尚无样本" },
        "missed_ticks": { "type": "integer", "description": "累计错过的计量 tick 数（缺口标记）" }
      }
    },
    "SysmonPlatformInfo": {
      "type": "object",
      "required": ["family", "version", "kernel", "arch", "build"],
      "properties": {
        "family": { "type": "string", "description": "平台家族：windows / linux" },
        "version": { "type": "string", "description": "真实 OS 版本" },
        "kernel": { "type": "string", "description": "Linux 内核 release；Windows 为 NT 版本号" },
        "arch": { "type": "string", "description": "架构标识" },
        "build": { "type": "integer", "description": "Windows build 号（区分 Win10/Win11）；Linux 为 0" }
      }
    },
    "SysmonSystemInfo": {
      "type": "object",
      "required": ["hostname", "cpu_model", "logical_cores", "boot_time_unix_sec", "uptime_sec"],
      "properties": {
        "hostname": { "type": "string", "description": "主机名" },
        "cpu_model": { "type": "string", "description": "CPU 型号；取不到时为空串" },
        "logical_cores": { "type": "integer", "description": "逻辑核数" },
        "boot_time_unix_sec": { "type": "integer", "description": "启动时间（Unix 秒）" },
        "uptime_sec": { "type": "integer", "description": "运行时长（秒）" }
      }
    },
    "SysmonCpuTotal": {
      "type": "object",
      "required": ["usage_ratio"],
      "properties": {
        "usage_ratio": {
          "description": "总使用率 [0,1]；null=首次采样/计数器不可用（不得用 0 冒充）",
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        }
      }
    },
    "SysmonCpuCore": {
      "type": "object",
      "required": ["index", "usage_ratio", "saturated"],
      "properties": {
        "index": { "type": "integer", "description": "核 index" },
        "usage_ratio": {
          "description": "单核使用率 [0,1]；null=不可用",
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        },
        "saturated": { "type": "boolean", "description": "是否处于持续饱和状态" }
      }
    },
    "SysmonCoreFrequency": {
      "type": "object",
      "required": ["index", "mhz"],
      "properties": {
        "index": { "type": "integer", "description": "OS CPU 编号（不保证连续，与 cpu.cores[].index 同源）" },
        "mhz": { "type": "integer", "description": "当前频率（MHz，> 0）" }
      }
    },
    "SysmonLoadAverage": {
      "type": "object",
      "required": ["one", "five", "fifteen", "semantic"],
      "properties": {
        "one": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "five": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "fifteen": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "semantic": { "type": "string", "description": "口径：load_average（Linux）/ processor_queue（Windows 代理量）" }
      }
    },
    "SysmonCpuInfo": {
      "type": "object",
      "required": ["total", "cores", "core_frequencies", "saturated_cores", "load_average", "context_switches_per_sec", "interrupts_per_sec"],
      "properties": {
        "total": { "$ref": "#/$defs/SysmonCpuTotal" },
        "cores": { "type": "array", "items": { "$ref": "#/$defs/SysmonCpuCore" }, "description": "每核使用率（不可用时为空数组）" },
        "core_frequencies": {
          "description": "每核当前频率；null=本平台不提供/不可用（不可用时区块整块不渲染）",
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/$defs/SysmonCoreFrequency" } },
            { "type": "null" }
          ]
        },
        "saturated_cores": { "type": "array", "items": { "type": "integer" }, "description": "持续饱和的核 index 集合" },
        "load_average": {
          "description": "系统负载；null=不提供/不可用（Windows 为处理器队列长度代理量，语义不同）",
          "anyOf": [{ "$ref": "#/$defs/SysmonLoadAverage" }, { "type": "null" }]
        },
        "context_switches_per_sec": {
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        },
        "interrupts_per_sec": {
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        }
      }
    },
    "SysmonMemoryInfo": {
      "type": "object",
      "required": ["total_bytes", "available_bytes", "used_bytes", "used_ratio"],
      "properties": {
        "total_bytes": { "type": "integer" },
        "available_bytes": { "type": "integer" },
        "used_bytes": { "type": "integer", "description": "唯一口径：total_bytes - available_bytes" },
        "used_ratio": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "cached_bytes": {
          "description": "可回收文件页缓存（Linux Cached+SReclaimable / Windows SystemCache）；null = 本平台不提供/本帧未读到",
          "anyOf": [{ "type": "integer" }, { "type": "null" }]
        },
        "buffers_bytes": {
          "description": "内核文件系统元数据缓存（Linux Buffers）；仅 Linux；Windows 恒 null",
          "anyOf": [{ "type": "integer" }, { "type": "null" }]
        }
      }
    },
    "SysmonSwapInfo": {
      "type": "object",
      "required": ["total_bytes", "used_bytes", "used_ratio"],
      "properties": {
        "total_bytes": { "type": "integer", "description": "0 = 本机无交换分区" },
        "used_bytes": { "type": "integer" },
        "used_ratio": { "anyOf": [{ "type": "number" }, { "type": "null" }] }
      }
    },
    "SysmonVolumeInfo": {
      "type": "object",
      "required": ["mount", "available", "total_bytes", "used_bytes", "used_ratio"],
      "properties": {
        "mount": { "type": "string", "description": "规范化挂载点（Linux 挂载目录；Windows 盘符根）" },
        "available": { "type": "boolean", "description": "容量是否可读；false 时三个容量字段必须为 null（不得用 0 冒充）" },
        "total_bytes": { "anyOf": [{ "type": "integer" }, { "type": "null" }], "description": "available=false 时为 null" },
        "used_bytes": { "anyOf": [{ "type": "integer" }, { "type": "null" }], "description": "available=false 时为 null" },
        "used_ratio": { "anyOf": [{ "type": "number" }, { "type": "null" }], "description": "available=false 或 total=0 时为 null" },
        "reason": { "type": "string", "description": "不可用原因；available=true 时省略" }
      }
    },
    "SysmonDiskIoInfo": {
      "type": "object",
      "required": ["device", "read_bytes_per_sec", "write_bytes_per_sec", "read_iops", "write_iops", "latency_ms", "queue_depth", "utilization"],
      "properties": {
        "device": { "type": "string", "description": "物理盘标识（Linux 为 sda/nvme0n1 等内核设备名；Windows 为 PhysicalDrive0 等物理盘号）" },
        "read_bytes_per_sec": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "description": "读吞吐（字节/秒）；首次采样/计数器重置/本帧未读到时为 null（不得用 0 冒充）" },
        "write_bytes_per_sec": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "description": "写吞吐（字节/秒）；首次采样/计数器重置/本帧未读到时为 null（不得用 0 冒充）" },
        "read_iops": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "description": "读 IOPS（每秒读请求数）；首次采样/计数器重置/本帧未读到时为 null（不得用 0 冒充）" },
        "write_iops": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "description": "写 IOPS（每秒写请求数）；首次采样/计数器重置/本帧未读到时为 null（不得用 0 冒充）" },
        "latency_ms": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "description": "平均每请求延迟（毫秒）；首次采样/计数器重置/本帧未读到时为 null（不得用 0 冒充）" },
        "queue_depth": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "description": "采样时刻在途请求数（瞬时 gauge，不是累计计数器）；计数器不可用时为 null（不得用 0 冒充）" },
        "utilization": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "maximum": 1, "description": "设备利用率（[0,1] 比率）；计数器不可用时为 null（不得用 0 冒充）" }
      }
    },
    "SysmonNetworkInfo": {
      "type": "object",
      "description": "每网卡累计收发与速率（契约 sysmon §2.4 network[]）。八个 *_total 为累计计数器、必填非负整数（累计量没有不可用语义）；六个 *_per_sec 为速率，首次采样/本帧新出现/计数器重置时为 null（不得用 0 冒充）。hide_virtual=true 时发送方已过滤 is_virtual 条目。",
      "required": ["interface", "rx_bytes_total", "tx_bytes_total", "rx_packets_total", "tx_packets_total", "rx_errors_total", "tx_errors_total", "rx_drops_total", "tx_drops_total", "rx_bytes_per_sec", "tx_bytes_per_sec", "rx_errors_per_sec", "tx_errors_per_sec", "rx_drops_per_sec", "tx_drops_per_sec", "is_virtual"],
      "properties": {
        "interface": { "type": "string", "description": "网卡名（Linux 内核接口名；Windows 适配器别名 Alias）；单帧内唯一" },
        "rx_bytes_total": { "type": "integer", "minimum": 0, "description": "累计接收字节数" },
        "tx_bytes_total": { "type": "integer", "minimum": 0, "description": "累计发送字节数" },
        "rx_packets_total": { "type": "integer", "minimum": 0, "description": "累计接收包数（含单播与组播/广播）" },
        "tx_packets_total": { "type": "integer", "minimum": 0, "description": "累计发送包数（含单播与组播/广播）" },
        "rx_errors_total": { "type": "integer", "minimum": 0, "description": "累计接收错误数" },
        "tx_errors_total": { "type": "integer", "minimum": 0, "description": "累计发送错误数" },
        "rx_drops_total": { "type": "integer", "minimum": 0, "description": "累计接收丢弃数" },
        "tx_drops_total": { "type": "integer", "minimum": 0, "description": "累计发送丢弃数" },
        "rx_bytes_per_sec": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "description": "接收吞吐（字节/秒）；首次采样/本帧新出现/计数器重置时为 null（不得用 0 冒充）" },
        "tx_bytes_per_sec": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "description": "发送吞吐（字节/秒）；首次采样/本帧新出现/计数器重置时为 null（不得用 0 冒充）" },
        "rx_errors_per_sec": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "description": "接收错误速率（个/秒）；不可用时为 null（不得用 0 冒充）" },
        "tx_errors_per_sec": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "description": "发送错误速率（个/秒）；不可用时为 null（不得用 0 冒充）" },
        "rx_drops_per_sec": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "description": "接收丢弃速率（个/秒）；不可用时为 null（不得用 0 冒充）" },
        "tx_drops_per_sec": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "description": "发送丢弃速率（个/秒）；不可用时为 null（不得用 0 冒充）" },
        "is_virtual": { "type": "boolean", "description": "是否虚拟网卡（不由硬件设备支撑）；hide_virtual=true 时发送方不输出 true 的条目" }
      }
    },
    "SysmonShmDirInfo": {
      "type": "object",
      "required": ["path", "total_bytes", "page_files", "oldest_file_age_sec"],
      "properties": {
        "path": { "type": "string" },
        "total_bytes": { "type": "integer" },
        "page_files": { "type": "integer" },
        "oldest_file_age_sec": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }
      }
    },
    "SysmonTemperatureInfo": {
      "type": "object",
      "required": ["sensor", "celsius"],
      "properties": {
        "sensor": { "type": "string", "description": "传感器稳定标识（Linux hwmon：<name>#<hwmonN>:<label>，无 label 时用 tempN）；也是历史库维度键，值不因新增 chip/label 而改变" },
        "chip": { "type": "string", "description": "芯片名（hwmon name，如 coretemp / amdgpu / acpitz）；additive 字段，旧版本发送方缺失时消费方从 sensor 回退解析" },
        "label": { "type": "string", "description": "通道标签（tempN_label）；additive 字段。缺失合法（旧版本发送方）；空串表示该通道没有标签（合法事实，不是不可用）" },
        "celsius": { "type": "number", "description": "摄氏温度（瞬时 gauge，不是累计计数器）" }
      }
    },
    "SysmonAvailabilityEntry": {
      "type": "object",
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "reason": { "type": "string", "description": "不可用原因；available=true 时省略" }
      }
    },
    "SysmonAvailability": {
      "type": "object",
      "required": ["platform_description", "metrics", "semantic_hints"],
      "properties": {
        "platform_description": { "type": "string", "description": "人类可读平台描述（Windows 含 build 号）" },
        "metrics": { "type": "object", "additionalProperties": { "$ref": "#/$defs/SysmonAvailabilityEntry" }, "description": "按指标可用性映射" },
        "semantic_hints": { "type": "object", "additionalProperties": { "type": "string" }, "description": "跨平台语义提示" }
      }
    },
    "SysmonSnapshotPayload": {
      "type": "object",
      "required": ["source", "timestamp", "sampling", "platform", "system", "cpu", "temperature", "memory", "swap", "volumes", "disk_io", "network", "shm_dir", "availability"],
      "properties": {
        "source": { "type": "string", "description": "发送方进程名（固定 dzsysmon；无 instance_id 帧来源显式携带，general §5）" },
        "timestamp": { "type": "integer", "description": "快照生成时刻（Unix 毫秒）" },
        "sampling": { "$ref": "#/$defs/SysmonSamplingMeta" },
        "platform": { "$ref": "#/$defs/SysmonPlatformInfo" },
        "system": { "$ref": "#/$defs/SysmonSystemInfo" },
        "cpu": { "$ref": "#/$defs/SysmonCpuInfo" },
        "temperature": {
          "description": "温度传感器读数；null=本平台不提供/无传感器/不可用（不可用时区块整块不渲染）",
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/$defs/SysmonTemperatureInfo" } },
            { "type": "null" }
          ]
        },
        "memory": { "anyOf": [{ "$ref": "#/$defs/SysmonMemoryInfo" }, { "type": "null" }] },
        "swap": { "anyOf": [{ "$ref": "#/$defs/SysmonSwapInfo" }, { "type": "null" }] },
        "volumes": { "anyOf": [{ "type": "array", "items": { "$ref": "#/$defs/SysmonVolumeInfo" } }, { "type": "null" }] },
        "disk_io": { "anyOf": [{ "type": "array", "items": { "$ref": "#/$defs/SysmonDiskIoInfo" } }, { "type": "null" }] },
        "network": { "anyOf": [{ "type": "array", "items": { "$ref": "#/$defs/SysmonNetworkInfo" } }, { "type": "null" }] },
        "shm_dir": { "anyOf": [{ "$ref": "#/$defs/SysmonShmDirInfo" }, { "type": "null" }] },
        "availability": { "$ref": "#/$defs/SysmonAvailability" }
      }
    },
    "SysmonSamplingConfigPayload": {
      "type": "object",
      "required": ["measure_interval_ms", "record_interval_sec", "phase_offset_sec", "groups"],
      "properties": {
        "measure_interval_ms": { "type": "integer", "description": "计量间隔 [100,60000]" },
        "record_interval_sec": { "type": "integer", "description": "记录间隔 [1,86400]" },
        "phase_offset_sec": { "type": "integer", "description": "记录相位偏移 [0,86400]" },
        "groups": { "type": "object", "additionalProperties": { "type": "boolean" }, "description": "启用的指标大类" }
      }
    },
    "SysmonDiskConfigPayload": {
      "type": "object",
      "required": ["devices"],
      "properties": {
        "devices": { "type": "array", "items": { "type": "string" }, "description": "设备范围（空=全部物理盘）" }
      }
    },
    "SysmonNetworkConfigPayload": {
      "type": "object",
      "required": ["hide_virtual"],
      "properties": {
        "hide_virtual": { "type": "boolean", "description": "是否隐藏虚拟网卡" }
      }
    },
    "SysmonHistoryConfigPayload": {
      "type": "object",
      "required": ["enabled", "raw_retention_hours", "max_retention_days", "max_bytes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "raw_retention_hours": { "type": "integer" },
        "max_retention_days": { "type": "integer" },
        "max_bytes": { "type": "integer", "description": "总量上限；0=不限制" }
      }
    },
    "SysmonRealtimeConfigPayload": {
      "type": "object",
      "required": ["push_interval_sec"],
      "properties": {
        "push_interval_sec": { "type": "integer", "description": "推送间隔 [1,3600]" }
      }
    },
    "SysmonThresholdsConfigPayload": {
      "type": "object",
      "required": ["cpu_sustain_used_pct", "cpu_sustain_samples", "memory_used_pct", "swap_used_pct", "volume_free_pct", "log_repeat_sec"],
      "properties": {
        "cpu_sustain_used_pct": { "type": "number" },
        "cpu_sustain_samples": { "type": "integer" },
        "memory_used_pct": { "type": "number" },
        "swap_used_pct": { "type": "number" },
        "volume_free_pct": { "type": "number" },
        "log_repeat_sec": { "type": "integer" }
      }
    },
    "SysmonConfigPayload": {
      "type": "object",
      "required": ["sampling", "disk", "network", "history", "realtime", "thresholds"],
      "properties": {
        "sampling": { "$ref": "#/$defs/SysmonSamplingConfigPayload" },
        "disk": { "$ref": "#/$defs/SysmonDiskConfigPayload" },
        "network": { "$ref": "#/$defs/SysmonNetworkConfigPayload" },
        "history": { "$ref": "#/$defs/SysmonHistoryConfigPayload" },
        "realtime": { "$ref": "#/$defs/SysmonRealtimeConfigPayload" },
        "thresholds": { "$ref": "#/$defs/SysmonThresholdsConfigPayload" }
      }
    },
    "TdDirection": {
      "type": "string",
      "enum": ["Long", "Short", "Net"],
      "description": "交易方向（契约 rest §2.9.3，值 = 帧枚举的 PascalCase 名）"
    },
    "TdPositionEffect": {
      "type": "string",
      "enum": ["Auto", "Open", "Close", "CloseToday", "CloseYesterday"],
      "description": "开平仓（契约 rest §2.9.3）"
    },
    "TdPriceType": {
      "type": "string",
      "enum": ["Limit", "Market", "Stop", "Fak", "Fok", "Rfq"],
      "description": "价格类型（契约 rest §2.9.3）"
    },
    "TdOrderStatus": {
      "type": "string",
      "enum": ["Submitting", "NotTraded", "PartTraded", "AllTraded", "Cancelled", "Rejected"],
      "description": "委托状态（契约 rest §2.9.3）"
    },
    "TdDegradedReason": {
      "type": "string",
      "enum": ["not_found", "schema_mismatch", "open_failed", "busy", "query_failed"],
      "description": "交易库读端点降级原因（契约 rest §2.9.8）"
    },
    "TdOrderRow": {
      "type": "object",
      "required": ["account_id", "date", "order_id", "strategy_id", "instrument_id", "exchange_id", "direction", "position_effect", "price_type", "status", "price", "volume", "volume_traded", "remark", "time", "avg_price", "price_decimals", "avg_price_decimals", "seq", "sort_key"],
      "description": "委托行（契约 rest §2.9.3；WS td_order_report 与 REST items 同一 schema）",
      "properties": {
        "account_id": { "type": "string", "description": "账户标识" },
        "date": { "type": "string", "description": "交易日 YYYYMMDD（= 信封 trading_day）" },
        "order_id": { "type": "integer", "description": "平台委托单 ID（全局唯一，业务键）" },
        "strategy_id": { "type": "string", "description": "策略 ID；非策略单为保留值 /external、/manual、/sync" },
        "instrument_id": { "type": "string", "description": "合约代码" },
        "exchange_id": { "type": "string", "description": "交易所 ID" },
        "direction": { "$ref": "#/$defs/TdDirection" },
        "position_effect": { "$ref": "#/$defs/TdPositionEffect" },
        "price_type": { "$ref": "#/$defs/TdPriceType" },
        "status": { "$ref": "#/$defs/TdOrderStatus" },
        "price": { "type": "number", "description": "委托价（double 全精度；市价单为 0）" },
        "volume": { "type": "integer", "description": "委托数量" },
        "volume_traded": { "type": "integer", "description": "已成交数量" },
        "remark": { "type": "string", "description": "委托备注；无则空串" },
        "time": { "type": "integer", "description": "报单时间：距午夜秒数 0–86399（真实时钟，前端格式化为 HH:MM:SS，不做时区转换）" },
        "avg_price": {
          "description": "成交均价（Σ价×量/Σ量）；无成交（volume_traded=0）时为 null",
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        },
        "price_decimals": { "type": "integer", "description": "委托价显示小数位（契约 rest §2.9.6）" },
        "avg_price_decimals": { "type": "integer", "description": "成交均价显示小数位（契约 rest §2.9.6）" },
        "seq": { "type": "integer", "description": "不透明版本号：合并用，不显示、不参与业务（契约 rest §2.9.6）" },
        "sort_key": { "type": "string", "description": "排序键：字符串降序 = 列表顺序（契约 rest §2.9.6）" }
      }
    },
    "TdTradeRow": {
      "type": "object",
      "required": ["account_id", "date", "trade_id", "order_id", "strategy_id", "instrument_id", "exchange_id", "direction", "position_effect", "price", "volume", "time", "price_decimals", "seq", "sort_key"],
      "description": "成交行（契约 rest §2.9.3；WS td_trade_report 与 REST items 同一 schema；业务键 = account_id|date|exchange_id|trade_id）",
      "properties": {
        "account_id": { "type": "string", "description": "账户标识" },
        "date": { "type": "string", "description": "交易日 YYYYMMDD" },
        "trade_id": { "type": "string", "description": "交易所成交 ID（仅交易所内唯一）" },
        "order_id": { "type": "integer", "description": "关联委托单 ID" },
        "strategy_id": { "type": "string", "description": "策略 ID；保留值语义同委托行" },
        "instrument_id": { "type": "string", "description": "合约代码" },
        "exchange_id": { "type": "string", "description": "交易所 ID（与 trade_id 组合唯一）" },
        "direction": { "$ref": "#/$defs/TdDirection" },
        "position_effect": { "$ref": "#/$defs/TdPositionEffect" },
        "price": { "type": "number", "description": "成交价（double 全精度）" },
        "volume": { "type": "integer", "description": "成交量" },
        "time": { "type": "integer", "description": "成交时间：距午夜秒数 0–86399" },
        "price_decimals": { "type": "integer", "description": "成交价显示小数位（契约 rest §2.9.6）" },
        "seq": { "type": "integer", "description": "不透明版本号（契约 rest §2.9.6）" },
        "sort_key": { "type": "string", "description": "排序键：字符串降序 = 列表顺序（契约 rest §2.9.6）" }
      }
    },
    "TdOrderListResponse": {
      "type": "object",
      "required": ["available", "trading_day", "online_accounts", "items", "next_cursor"],
      "description": "GET /api/td/orders 可用响应信封（契约 rest §2.9.2）",
      "properties": {
        "available": { "type": "boolean", "description": "true = 交易库可读" },
        "trading_day": {
          "description": "当前交易日 YYYYMMDD；无在线账户时 null",
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "online_accounts": { "type": "array", "items": { "type": "string" }, "description": "在线（Ready）账户集合；顺序不承诺" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/TdOrderRow" }, "description": "委托行；空数组 = 无数据（不是错误）" },
        "next_cursor": {
          "description": "下一页游标；null = 没有更多",
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "TdOrderDegradedResponse": {
      "type": "object",
      "required": ["available", "reason"],
      "description": "GET /api/td/orders 降级响应（200 + available=false，契约 rest §2.9.8）",
      "properties": {
        "available": { "type": "boolean", "description": "false = 降级（响应只有 available 与 reason）" },
        "reason": { "$ref": "#/$defs/TdDegradedReason" }
      }
    },
    "TdTradeListResponse": {
      "type": "object",
      "required": ["available", "trading_day", "online_accounts", "items", "next_cursor"],
      "description": "GET /api/td/trades 可用响应信封（契约 rest §2.9.2，与委托列表同形）",
      "properties": {
        "available": { "type": "boolean", "description": "true = 交易库可读" },
        "trading_day": {
          "description": "当前交易日 YYYYMMDD；无在线账户时 null",
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "online_accounts": { "type": "array", "items": { "type": "string" }, "description": "在线（Ready）账户集合；顺序不承诺" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/TdTradeRow" }, "description": "成交行；空数组 = 无数据（不是错误）" },
        "next_cursor": {
          "description": "下一页游标；null = 没有更多",
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "TdTradeDegradedResponse": {
      "type": "object",
      "required": ["available", "reason"],
      "description": "GET /api/td/trades 降级响应（200 + available=false，契约 rest §2.9.8）",
      "properties": {
        "available": { "type": "boolean", "description": "false = 降级（响应只有 available 与 reason）" },
        "reason": { "$ref": "#/$defs/TdDegradedReason" }
      }
    },
    "TdPositionRow": {
      "type": "object",
      "required": ["account_id", "date", "instrument_id", "exchange_id", "direction", "volume", "frozen_volume", "today_volume", "yd_volume", "price", "price_decimals", "seq"],
      "description": "持仓行（契约 rest §2.9.4；WS td_position_info 与 REST items 同一 schema；业务键 = account_id|instrument_id|direction；**没有 sort_key**，列表顺序 = 服务端 (account_id, instrument_id, direction) 升序）",
      "properties": {
        "account_id": { "type": "string", "description": "账户标识" },
        "date": { "type": "string", "description": "该账户锚点日 YYYYMMDD（不是全局当前交易日；可能早于信封 trading_day）" },
        "instrument_id": { "type": "string", "description": "合约代码" },
        "exchange_id": { "type": "string", "description": "交易所 ID" },
        "direction": { "$ref": "#/$defs/TdDirection" },
        "volume": { "type": "integer", "description": "总持仓（含今仓与昨仓）" },
        "frozen_volume": { "type": "integer", "description": "冻结量" },
        "today_volume": { "type": "integer", "description": "今仓" },
        "yd_volume": { "type": "integer", "description": "昨仓" },
        "price": { "type": "number", "description": "持仓均价（double 全精度）" },
        "price_decimals": { "type": "integer", "description": "持仓均价显示小数位（契约 rest §2.9.6）" },
        "seq": { "type": "integer", "description": "不透明版本号：合并用，不显示、不参与业务（契约 rest §2.9.6）" }
      }
    },
    "TdPositionListResponse": {
      "type": "object",
      "required": ["available", "trading_day", "online_accounts", "items", "next_cursor"],
      "description": "GET /api/td/positions 可用响应信封（契约 rest §2.9.2，与委托/成交同形；items 覆盖全部已登记账户含离线）",
      "properties": {
        "available": { "type": "boolean", "description": "true = 交易库可读" },
        "trading_day": {
          "description": "当前交易日 YYYYMMDD；无在线账户时 null（持仓行自身的 date 是各账户锚点日，两者不同）",
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "online_accounts": { "type": "array", "items": { "type": "string" }, "description": "在线（Ready）账户集合；顺序不承诺（不是持仓的账户全集，见契约 webui-ws §5 第 11 条）" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/TdPositionRow" }, "description": "持仓行（volume=0 的行不返回，契约 rest §2.9.1 空语义）；空数组 = 无数据（不是错误）" },
        "next_cursor": {
          "description": "下一页游标；null = 没有更多",
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "TdPositionDegradedResponse": {
      "type": "object",
      "required": ["available", "reason"],
      "description": "GET /api/td/positions 降级响应（200 + available=false，契约 rest §2.9.8）",
      "properties": {
        "available": { "type": "boolean", "description": "false = 降级（响应只有 available 与 reason）" },
        "reason": { "$ref": "#/$defs/TdDegradedReason" }
      }
    },
    "TdRecentPayload": {
      "type": "object",
      "required": ["events"],
      "description": "建连补发载荷（契约 webui-ws §2.5 td_recent）；无事件时仍发送空数组",
      "properties": {
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/TdRecentEvent" },
          "description": "各在线账户补发环内容，按入环先后从旧到新；不同账户之间顺序不承诺"
        }
      }
    },
    "TdRecentEvent": {
      "type": "object",
      "required": ["type", "data"],
      "description": "补发事件（type ∈ td_order_report | td_trade_report | td_position_info | td_trading_account）",
      "properties": {
        "type": { "type": "string", "description": "四类交易事件名之一（前端按 type 分发到对应合并逻辑）" },
        "data": { "type": "unknown", "description": "行对象，schema 由 type 对应的契约 rest §2.9.3/§2.9.4 定义" }
      }
    },
    "TdStatsDegradedReason": {
      "type": "string",
      "enum": ["not_ready"],
      "description": "统计计数器降级原因（契约 rest §2.9.5；与列表的库失败降级 §2.9.8 分开）"
    },
    "TdStatsValues": {
      "type": "object",
      "required": ["total_orders", "total_volume", "unfilled_orders", "unfilled_volume"],
      "description": "统计计数器 4 值（契约 rest §2.9.5；口径 = 当前交易日 + 全部在线账户）",
      "properties": {
        "total_orders": { "type": "integer", "description": "当前交易日全部委托笔数（含撤单、废单）" },
        "total_volume": { "type": "integer", "description": "上述委托的 volume 之和" },
        "unfilled_orders": { "type": "integer", "description": "status ∈ {Submitting, NotTraded, PartTraded} 的委托笔数" },
        "unfilled_volume": { "type": "integer", "description": "上述委托的 (volume − volume_traded) 之和" }
      }
    },
    "TdStatsAvailable": {
      "type": "object",
      "required": ["available", "trading_day", "online_accounts", "stats"],
      "description": "GET /api/td/stats 可用响应（契约 rest §2.9.5；不是列表，无 items/next_cursor）",
      "properties": {
        "available": { "type": "boolean", "description": "true = 统计计数器已就绪" },
        "trading_day": {
          "description": "当前交易日 YYYYMMDD；无在线账户时 null",
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        },
        "online_accounts": { "type": "array", "items": { "type": "string" }, "description": "在线（Ready）账户集合；顺序不承诺" },
        "stats": { "$ref": "#/$defs/TdStatsValues" }
      }
    },
    "TdStatsDegraded": {
      "type": "object",
      "required": ["available", "reason"],
      "description": "GET /api/td/stats 降级响应（200 + available=false，契约 rest §2.9.5：计数器未就绪）",
      "properties": {
        "available": { "type": "boolean", "description": "false = 计数器未就绪（响应只有 available 与 reason）" },
        "reason": { "$ref": "#/$defs/TdStatsDegradedReason" }
      }
    }
  }
}