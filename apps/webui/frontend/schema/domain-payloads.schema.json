{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "domain-payloads",
  "title": "WS 领域载荷（前端单源 schema）",
  "description": "dzweb → 前端 WS 消息 data 的权威 schema。真源=帧契约（process/progress 等）。前端 src/types/generated.ts 由 scripts/gen-types.mjs 生成，禁止手改。新增/修改字段必须同步更新对应帧契约。",
  "$defs": {
    "ProcessState": {
      "type": "string",
      "enum": ["Starting", "Running", "Stopping", "Stopped", "Crashed"],
      "description": "进程状态（契约 process）"
    },
    "ProcessEvent": {
      "type": "string",
      "enum": ["StartSucceeded", "StartFailed", "StopSucceeded", "StopFailed", "RemoveSucceeded", "RemoveFailed"],
      "description": "进程操作结果事件（契约 process）"
    },
    "ProcessStatusPayload": {
      "type": "object",
      "required": ["name", "state", "pid"],
      "properties": {
        "name": { "type": "string", "description": "进程名" },
        "state": { "$ref": "#/$defs/ProcessState" },
        "pid": { "type": "integer", "description": "进程 PID，未运行时为 0" },
        "display_name": { "type": "string", "description": "用户可读显示名；缺省为空串" },
        "message": { "type": "string", "description": "状态说明/失败原因；缺省为空串" },
        "event": {
          "description": "操作结果事件；缺失或 null 均为自发状态变化（契约 webui-ws §2.2）",
          "anyOf": [{ "$ref": "#/$defs/ProcessEvent" }, { "type": "null" }]
        }
      }
    },
    "ProgressStatus": {
      "type": "object",
      "required": ["min", "max", "current"],
      "properties": {
        "min": { "type": "integer" },
        "max": { "type": "integer", "description": "max <= min（含 max==0）表示不确定进度" },
        "current": { "type": "integer" },
        "desc": { "type": "string", "description": "简短文本说明；空串/省略=无文本" }
      }
    },
    "LogConfigPayload": {
      "type": "object",
      "required": ["level", "flush_on"],
      "properties": {
        "level": { "type": "string", "description": "当前生效级别，始终为规范全称（契约 log）" },
        "flush_on": { "type": "string", "description": "当前生效 flush 阈值，始终为规范全称" }
      }
    },
    "AutoLoginSchedule": {
      "type": "object",
      "required": ["login_time", "logout_time"],
      "properties": {
        "login_time": { "type": "string", "description": "登录时间 HH:MM（进程本地时间）" },
        "logout_time": { "type": "string", "description": "登出时间 HH:MM（进程本地时间）" }
      }
    },
    "AutoLoginPayload": {
      "type": "object",
      "required": ["enabled", "schedules"],
      "properties": {
        "enabled": { "type": "boolean", "description": "是否启用自动登录排程" },
        "schedules": { "type": "array", "items": { "$ref": "#/$defs/AutoLoginSchedule" }, "description": "排程整体覆盖（契约 auto-login）" }
      }
    },
    "NotifyUiPayload": {
      "type": "object",
      "required": ["source", "level", "message", "timestamp", "popup"],
      "properties": {
        "source": { "type": "string", "description": "通知来源（进程名或策略 ID）" },
        "level": { "type": "string", "enum": ["info", "warning", "error"], "description": "通知级别" },
        "message": { "type": "string", "description": "通知正文" },
        "timestamp": { "type": "integer", "description": "Unix 秒级时间戳" },
        "popup": { "type": "boolean", "description": "是否弹窗打断用户" }
      }
    },
    "BrokerFrontend": {
      "type": "object",
      "required": ["address", "label", "enabled"],
      "properties": {
        "address": { "type": "string", "description": "前置地址，非空（契约 md-config）" },
        "label": { "type": "string", "description": "可选人类可读标签，可为空" },
        "enabled": { "type": "boolean", "description": "是否启用（注册到 CTP）" }
      }
    },
    "BrokerEntry": {
      "type": "object",
      "required": ["name", "broker_id", "user_id", "password", "product_info", "frontends"],
      "properties": {
        "name": { "type": "string", "description": "经纪商不可变 key" },
        "broker_id": { "type": "string", "description": "经纪公司代码" },
        "user_id": { "type": "string", "description": "用户代码" },
        "password": { "type": "string", "description": "登录密码（生产/RTN 脱敏为 ****）" },
        "product_info": { "type": "string", "description": "产品信息" },
        "frontends": { "type": "array", "items": { "$ref": "#/$defs/BrokerFrontend" }, "description": "前置地址列表" }
      }
    },
    "MdConfigPayload": {
      "type": "object",
      "required": ["brokers", "current_broker_name"],
      "properties": {
        "brokers": { "type": "array", "items": { "$ref": "#/$defs/BrokerEntry" }, "description": "经纪商列表（RTN 全量）" },
        "current_broker_name": { "type": "string", "description": "当前选中经纪商名，空或指向存在的经纪商" },
        "subscribe_batch_size": { "type": "integer", "description": "每批订阅数量" },
        "subscribe_batch_delay_ms": { "type": "integer", "description": "批间延迟（毫秒）" },
        "sub_check_interval_ms": { "type": "integer", "description": "补订检查间隔（毫秒）" },
        "sub_max_retry": { "type": "integer", "description": "补订最大重试" }
      }
    },
    "MdRtnConfigPayload": {
      "type": "object",
      "required": ["source", "config"],
      "properties": {
        "source": { "type": "string", "description": "行情源进程名" },
        "config": { "$ref": "#/$defs/MdConfigPayload", "description": "脱敏行情配置" }
      }
    },
    "PreloadPoint": {
      "type": "object",
      "required": ["pages", "bytes"],
      "properties": {
        "pages": { "type": "integer", "description": "预加载页数，范围 [0,8]" },
        "bytes": { "type": "integer", "description": "预加载字节数，范围 [0,2^40]" }
      }
    },
    "ShmConfigView": {
      "type": "object",
      "required": ["page_size_mb", "preload_points", "check_interval_min", "check_pages", "check_bytes"],
      "properties": {
        "page_size_mb": { "type": "integer", "description": "页大小（MB），启动后不可变" },
        "preload_points": { "type": "object", "additionalProperties": { "$ref": "#/$defs/PreloadPoint" }, "description": "预加载点，key=HH:MM" },
        "check_interval_min": { "type": "integer", "description": "周期检查间隔（分钟），0=不检查" },
        "check_pages": { "type": "integer", "description": "周期检查预加载页数" },
        "check_bytes": { "type": "integer", "description": "周期检查预加载字节数" }
      }
    },
    "LogLine": {
      "type": "object",
      "required": ["n", "ts", "level", "logger", "func", "file", "line", "pid", "tid", "msg", "raw", "parsed"],
      "properties": {
        "n": { "type": "integer", "description": "行号" },
        "ts": { "type": "string", "description": "时间戳" },
        "level": { "type": "string", "description": "日志级别" },
        "logger": { "type": "string", "description": "logger 名" },
        "func": { "type": "string", "description": "函数名" },
        "file": { "type": "string", "description": "源文件名" },
        "line": { "type": "integer", "description": "源文件行号" },
        "pid": { "type": "string", "description": "进程 ID" },
        "tid": { "type": "string", "description": "线程 ID" },
        "msg": { "type": "string", "description": "日志消息" },
        "raw": { "type": "string", "description": "原始行" },
        "parsed": { "type": "boolean", "description": "是否已结构化解析" }
      }
    },
    "MdRtnStatusPayload": {
      "type": "object",
      "required": ["source", "status"],
      "properties": {
        "source": { "type": "string", "description": "行情源进程名" },
        "status": { "type": "object", "additionalProperties": true, "description": "网关状态（结构随接口类型）" }
      }
    },
    "SysmonSamplingMeta": {
      "type": "object",
      "required": ["measure_interval_ms", "last_sample_unix_ms", "missed_ticks"],
      "properties": {
        "measure_interval_ms": { "type": "integer", "description": "当前计量间隔（毫秒）" },
        "last_sample_unix_ms": { "type": "integer", "description": "最近一次计量成功的 Unix 毫秒时间；0=尚无样本" },
        "missed_ticks": { "type": "integer", "description": "累计错过的计量 tick 数（缺口标记）" }
      }
    },
    "SysmonPlatformInfo": {
      "type": "object",
      "required": ["family", "version", "kernel", "arch", "build"],
      "properties": {
        "family": { "type": "string", "description": "平台家族：windows / linux" },
        "version": { "type": "string", "description": "真实 OS 版本" },
        "kernel": { "type": "string", "description": "Linux 内核 release；Windows 为 NT 版本号" },
        "arch": { "type": "string", "description": "架构标识" },
        "build": { "type": "integer", "description": "Windows build 号（区分 Win10/Win11）；Linux 为 0" }
      }
    },
    "SysmonSystemInfo": {
      "type": "object",
      "required": ["hostname", "cpu_model", "logical_cores", "boot_time_unix_sec", "uptime_sec"],
      "properties": {
        "hostname": { "type": "string", "description": "主机名" },
        "cpu_model": { "type": "string", "description": "CPU 型号；取不到时为空串" },
        "logical_cores": { "type": "integer", "description": "逻辑核数" },
        "boot_time_unix_sec": { "type": "integer", "description": "启动时间（Unix 秒）" },
        "uptime_sec": { "type": "integer", "description": "运行时长（秒）" }
      }
    },
    "SysmonCpuTotal": {
      "type": "object",
      "required": ["usage_ratio"],
      "properties": {
        "usage_ratio": {
          "description": "总使用率 [0,1]；null=首次采样/计数器不可用（不得用 0 冒充）",
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        }
      }
    },
    "SysmonCpuCore": {
      "type": "object",
      "required": ["index", "usage_ratio", "saturated"],
      "properties": {
        "index": { "type": "integer", "description": "核 index" },
        "usage_ratio": {
          "description": "单核使用率 [0,1]；null=不可用",
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        },
        "saturated": { "type": "boolean", "description": "是否处于持续饱和状态" }
      }
    },
    "SysmonCoreFrequency": {
      "type": "object",
      "required": ["index", "mhz"],
      "properties": {
        "index": { "type": "integer", "description": "OS CPU 编号（不保证连续，与 cpu.cores[].index 同源）" },
        "mhz": { "type": "integer", "description": "当前频率（MHz，> 0）" }
      }
    },
    "SysmonLoadAverage": {
      "type": "object",
      "required": ["one", "five", "fifteen", "semantic"],
      "properties": {
        "one": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "five": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "fifteen": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "semantic": { "type": "string", "description": "口径：load_average（Linux）/ processor_queue（Windows 代理量）" }
      }
    },
    "SysmonCpuInfo": {
      "type": "object",
      "required": ["total", "cores", "core_frequencies", "saturated_cores", "load_average", "context_switches_per_sec", "interrupts_per_sec"],
      "properties": {
        "total": { "$ref": "#/$defs/SysmonCpuTotal" },
        "cores": { "type": "array", "items": { "$ref": "#/$defs/SysmonCpuCore" }, "description": "每核使用率（不可用时为空数组）" },
        "core_frequencies": {
          "description": "每核当前频率；null=本平台不提供/不可用（不可用时区块整块不渲染）",
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/$defs/SysmonCoreFrequency" } },
            { "type": "null" }
          ]
        },
        "saturated_cores": { "type": "array", "items": { "type": "integer" }, "description": "持续饱和的核 index 集合" },
        "load_average": {
          "description": "系统负载；null=不提供/不可用（Windows 为处理器队列长度代理量，语义不同）",
          "anyOf": [{ "$ref": "#/$defs/SysmonLoadAverage" }, { "type": "null" }]
        },
        "context_switches_per_sec": {
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        },
        "interrupts_per_sec": {
          "anyOf": [{ "type": "number" }, { "type": "null" }]
        }
      }
    },
    "SysmonMemoryInfo": {
      "type": "object",
      "required": ["total_bytes", "available_bytes", "used_bytes", "used_ratio"],
      "properties": {
        "total_bytes": { "type": "integer" },
        "available_bytes": { "type": "integer" },
        "used_bytes": { "type": "integer", "description": "唯一口径：total_bytes - available_bytes" },
        "used_ratio": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "cached_bytes": {
          "description": "可回收文件页缓存（Linux Cached+SReclaimable / Windows SystemCache）；null = 本平台不提供/本帧未读到",
          "anyOf": [{ "type": "integer" }, { "type": "null" }]
        },
        "buffers_bytes": {
          "description": "内核文件系统元数据缓存（Linux Buffers）；仅 Linux；Windows 恒 null",
          "anyOf": [{ "type": "integer" }, { "type": "null" }]
        }
      }
    },
    "SysmonSwapInfo": {
      "type": "object",
      "required": ["total_bytes", "used_bytes", "used_ratio"],
      "properties": {
        "total_bytes": { "type": "integer", "description": "0 = 本机无交换分区" },
        "used_bytes": { "type": "integer" },
        "used_ratio": { "anyOf": [{ "type": "number" }, { "type": "null" }] }
      }
    },
    "SysmonVolumeInfo": {
      "type": "object",
      "required": ["mount", "watched", "available", "total_bytes", "used_bytes", "used_ratio"],
      "properties": {
        "mount": { "type": "string", "description": "规范化挂载点（Linux 挂载目录；Windows 盘符根）" },
        "watched": { "type": "boolean", "description": "承载了任一关注路径（快照 watch_paths 的落卷），用于高亮" },
        "available": { "type": "boolean", "description": "容量是否可读；false 时三个容量字段必须为 null（不得用 0 冒充）" },
        "total_bytes": { "anyOf": [{ "type": "integer" }, { "type": "null" }], "description": "available=false 时为 null" },
        "used_bytes": { "anyOf": [{ "type": "integer" }, { "type": "null" }], "description": "available=false 时为 null" },
        "used_ratio": { "anyOf": [{ "type": "number" }, { "type": "null" }], "description": "available=false 或 total=0 时为 null" },
        "reason": { "type": "string", "description": "不可用原因；available=true 时省略" }
      }
    },
    "SysmonWatchPathInfo": {
      "type": "object",
      "required": ["path", "mount", "available"],
      "properties": {
        "path": { "type": "string", "description": "关注路径（绝对路径，符号链接已跟随）" },
        "mount": { "anyOf": [{ "type": "string" }, { "type": "null" }], "description": "所在卷挂载点，可与 volumes[].mount 相等比较；解析失败时为 null" },
        "available": { "type": "boolean", "description": "落卷解析是否成功" },
        "reason": { "type": "string", "description": "解析失败原因；available=true 时省略" }
      }
    },
    "SysmonDiskIoInfo": {
      "type": "object",
      "required": ["device", "read_bytes_per_sec", "write_bytes_per_sec", "read_iops", "write_iops", "latency_ms", "queue_depth", "utilization"],
      "properties": {
        "device": { "type": "string", "description": "物理盘标识（Linux 为 sda/nvme0n1 等内核设备名；Windows 为 PhysicalDrive0 等物理盘号）" },
        "read_bytes_per_sec": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "description": "读吞吐（字节/秒）；首次采样/计数器重置/本帧未读到时为 null（不得用 0 冒充）" },
        "write_bytes_per_sec": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "description": "写吞吐（字节/秒）；首次采样/计数器重置/本帧未读到时为 null（不得用 0 冒充）" },
        "read_iops": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "description": "读 IOPS（每秒读请求数）；首次采样/计数器重置/本帧未读到时为 null（不得用 0 冒充）" },
        "write_iops": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "description": "写 IOPS（每秒写请求数）；首次采样/计数器重置/本帧未读到时为 null（不得用 0 冒充）" },
        "latency_ms": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "description": "平均每请求延迟（毫秒）；首次采样/计数器重置/本帧未读到时为 null（不得用 0 冒充）" },
        "queue_depth": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "description": "采样时刻在途请求数（瞬时 gauge，不是累计计数器）；计数器不可用时为 null（不得用 0 冒充）" },
        "utilization": { "anyOf": [{ "type": "number" }, { "type": "null" }], "minimum": 0, "maximum": 1, "description": "设备利用率（[0,1] 比率）；计数器不可用时为 null（不得用 0 冒充）" }
      }
    },
    "SysmonNetworkInfo": {
      "type": "object",
      "required": ["interface", "rx_bytes_total", "tx_bytes_total", "rx_bytes_per_sec", "tx_bytes_per_sec", "rx_errors_per_sec", "tx_errors_per_sec", "rx_drops_per_sec", "tx_drops_per_sec", "is_virtual"],
      "properties": {
        "interface": { "type": "string", "description": "网卡名" },
        "rx_bytes_total": { "type": "integer" },
        "tx_bytes_total": { "type": "integer" },
        "rx_bytes_per_sec": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "tx_bytes_per_sec": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "rx_errors_per_sec": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "tx_errors_per_sec": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "rx_drops_per_sec": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "tx_drops_per_sec": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
        "is_virtual": { "type": "boolean", "description": "是否虚拟网卡" }
      }
    },
    "SysmonShmDirInfo": {
      "type": "object",
      "required": ["path", "total_bytes", "page_files", "oldest_file_age_sec"],
      "properties": {
        "path": { "type": "string" },
        "total_bytes": { "type": "integer" },
        "page_files": { "type": "integer" },
        "oldest_file_age_sec": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }
      }
    },
    "SysmonTemperatureInfo": {
      "type": "object",
      "required": ["sensor", "celsius"],
      "properties": {
        "sensor": { "type": "string", "description": "传感器稳定标识（Linux hwmon：<name>#<hwmonN>:<label>，无 label 时用 tempN）" },
        "celsius": { "type": "number", "description": "摄氏温度（瞬时 gauge，不是累计计数器）" }
      }
    },
    "SysmonAvailabilityEntry": {
      "type": "object",
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "reason": { "type": "string", "description": "不可用原因；available=true 时省略" }
      }
    },
    "SysmonAvailability": {
      "type": "object",
      "required": ["platform_description", "metrics", "semantic_hints"],
      "properties": {
        "platform_description": { "type": "string", "description": "人类可读平台描述（Windows 含 build 号）" },
        "metrics": { "type": "object", "additionalProperties": { "$ref": "#/$defs/SysmonAvailabilityEntry" }, "description": "按指标可用性映射" },
        "semantic_hints": { "type": "object", "additionalProperties": { "type": "string" }, "description": "跨平台语义提示" }
      }
    },
    "SysmonSnapshotPayload": {
      "type": "object",
      "required": ["source", "timestamp", "sampling", "platform", "system", "cpu", "temperature", "memory", "swap", "volumes", "watch_paths", "disk_io", "network", "shm_dir", "availability"],
      "properties": {
        "source": { "type": "string", "description": "发送方进程名（固定 dzsysmon；无 instance_id 帧来源显式携带，general §5）" },
        "timestamp": { "type": "integer", "description": "快照生成时刻（Unix 毫秒）" },
        "sampling": { "$ref": "#/$defs/SysmonSamplingMeta" },
        "platform": { "$ref": "#/$defs/SysmonPlatformInfo" },
        "system": { "$ref": "#/$defs/SysmonSystemInfo" },
        "cpu": { "$ref": "#/$defs/SysmonCpuInfo" },
        "temperature": {
          "description": "温度传感器读数；null=本平台不提供/无传感器/不可用（不可用时区块整块不渲染）",
          "anyOf": [
            { "type": "array", "items": { "$ref": "#/$defs/SysmonTemperatureInfo" } },
            { "type": "null" }
          ]
        },
        "memory": { "anyOf": [{ "$ref": "#/$defs/SysmonMemoryInfo" }, { "type": "null" }] },
        "swap": { "anyOf": [{ "$ref": "#/$defs/SysmonSwapInfo" }, { "type": "null" }] },
        "volumes": { "anyOf": [{ "type": "array", "items": { "$ref": "#/$defs/SysmonVolumeInfo" } }, { "type": "null" }] },
        "watch_paths": { "anyOf": [{ "type": "array", "items": { "$ref": "#/$defs/SysmonWatchPathInfo" } }, { "type": "null" }], "description": "关注路径的落卷解析；null=本帧未采集/不可用" },
        "disk_io": { "anyOf": [{ "type": "array", "items": { "$ref": "#/$defs/SysmonDiskIoInfo" } }, { "type": "null" }] },
        "network": { "anyOf": [{ "type": "array", "items": { "$ref": "#/$defs/SysmonNetworkInfo" } }, { "type": "null" }] },
        "shm_dir": { "anyOf": [{ "$ref": "#/$defs/SysmonShmDirInfo" }, { "type": "null" }] },
        "availability": { "$ref": "#/$defs/SysmonAvailability" }
      }
    },
    "SysmonSamplingConfigPayload": {
      "type": "object",
      "required": ["measure_interval_ms", "record_interval_sec", "phase_offset_sec", "groups"],
      "properties": {
        "measure_interval_ms": { "type": "integer", "description": "计量间隔 [100,60000]" },
        "record_interval_sec": { "type": "integer", "description": "记录间隔 [1,86400]" },
        "phase_offset_sec": { "type": "integer", "description": "记录相位偏移 [0,86400]" },
        "groups": { "type": "object", "additionalProperties": { "type": "boolean" }, "description": "启用的指标大类" }
      }
    },
    "SysmonDiskConfigPayload": {
      "type": "object",
      "required": ["watch_paths", "devices"],
      "properties": {
        "watch_paths": { "type": "array", "items": { "type": "string" }, "description": "关注路径" },
        "devices": { "type": "array", "items": { "type": "string" }, "description": "设备范围（空=全部物理盘）" }
      }
    },
    "SysmonNetworkConfigPayload": {
      "type": "object",
      "required": ["hide_virtual"],
      "properties": {
        "hide_virtual": { "type": "boolean", "description": "是否隐藏虚拟网卡" }
      }
    },
    "SysmonHistoryConfigPayload": {
      "type": "object",
      "required": ["enabled", "raw_retention_hours", "max_retention_days", "max_bytes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "raw_retention_hours": { "type": "integer" },
        "max_retention_days": { "type": "integer" },
        "max_bytes": { "type": "integer", "description": "总量上限；0=不限制" }
      }
    },
    "SysmonRealtimeConfigPayload": {
      "type": "object",
      "required": ["push_interval_sec"],
      "properties": {
        "push_interval_sec": { "type": "integer", "description": "推送间隔 [1,3600]" }
      }
    },
    "SysmonAlertsConfigPayload": {
      "type": "object",
      "required": ["cpu_sustain_used_pct", "cpu_sustain_samples", "memory_used_pct", "swap_used_pct", "volume_free_pct", "volume_free_bytes", "cooldown_sec"],
      "properties": {
        "cpu_sustain_used_pct": { "type": "number" },
        "cpu_sustain_samples": { "type": "integer" },
        "memory_used_pct": { "type": "number" },
        "swap_used_pct": { "type": "number" },
        "volume_free_pct": { "type": "number" },
        "volume_free_bytes": { "type": "integer" },
        "cooldown_sec": { "type": "integer" }
      }
    },
    "SysmonConfigPayload": {
      "type": "object",
      "required": ["sampling", "disk", "network", "history", "realtime", "alerts"],
      "properties": {
        "sampling": { "$ref": "#/$defs/SysmonSamplingConfigPayload" },
        "disk": { "$ref": "#/$defs/SysmonDiskConfigPayload" },
        "network": { "$ref": "#/$defs/SysmonNetworkConfigPayload" },
        "history": { "$ref": "#/$defs/SysmonHistoryConfigPayload" },
        "realtime": { "$ref": "#/$defs/SysmonRealtimeConfigPayload" },
        "alerts": { "$ref": "#/$defs/SysmonAlertsConfigPayload" }
      }
    }
  }
}