/**
 * @file version.h
 * @brief 版本号宏定义
 *
 * 由 CMake 从 version.h.in 自动生成，不要手动编辑。
 * 单一真相源为根 CMakeLists.txt 的 project(VERSION)（ADR 0038）。
 */
#ifndef DZTRADER_VERSION_H_
#define DZTRADER_VERSION_H_

// clang-format off

/** @brief 主版本号 */
#define DZ_VERSION_MAJOR  ${VERSION_MAJOR}
/** @brief 次版本号 */
#define DZ_VERSION_MINOR  ${VERSION_MINOR}
/** @brief 补丁版本号 */
#define DZ_VERSION_PATCH  ${VERSION_ALTER}
/** @brief SemVer pre-release 标识（不含前导连字符），正式版为空串 */
#define DZ_VERSION_PRERELEASE "${DZ_PRERELEASE}"
/** @brief 完整版本串，含 pre-release：如 "0.1.0" 或 "0.1.0-rc1" */
#define DZ_VERSION_STRING "${VERSION_FULL}"

// clang-format on

#endif /* DZTRADER_VERSION_H_ */
