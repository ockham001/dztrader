#!/usr/bin/env bash
# pre-push — 推送前守卫（本地第一道；远端还有 GitHub main ruleset 兜底）。
#
#   - 拒绝直接推送 refs/heads/main：必须走 PR（应急逃生：DZ_ALLOW_MAIN_PUSH=1）
#   - 白名单 feature 分支：从分支名提取 issue 号，跑 scripts/check-push-scope.sh <n> --base origin/main
#     （只拦「推错票分支」与「CI 进行中重复 push」；无 issue 号或脚本不可用时警告放行）
#   - 删除远端分支（local ref 为 (delete)）放行
#
# 逃生口：DZ_SKIP_HOOKS=1 git push ...   （或 git push --no-verify）

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0

[ "${DZ_SKIP_HOOKS:-0}" = "1" ] && exit 0

blocked=0
warn() { printf 'pre-push: %s\n' "$*" >&2; }

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${remote_ref:-}" ] && continue

    if [ "$remote_ref" = "refs/heads/main" ]; then
        if [ "${DZ_ALLOW_MAIN_PUSH:-0}" = "1" ]; then
            warn "WARNING: direct push to main allowed by DZ_ALLOW_MAIN_PUSH=1 (emergency only)"
            continue
        fi
        warn "direct push to refs/heads/main is blocked: open a PR instead (docs/agents/ticket-closeout.md)"
        blocked=1
        continue
    fi

    if [ "$local_ref" = "(delete)" ] || [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    branch="${remote_ref#refs/heads/}"
    issue="$(printf '%s' "$branch" | sed -n 's#.*issue-\([0-9][0-9]*\).*#\1#p' | head -1)"
    if [ -z "$issue" ]; then
        warn "branch '$branch' has no issue-<n> in its name; skipping push-scope check (remote ruleset still applies)"
        continue
    fi
    if [ ! -f scripts/check-push-scope.sh ]; then
        warn "warning: scripts/check-push-scope.sh missing; skipping push-scope check"
        continue
    fi

    bash scripts/check-push-scope.sh "$issue" --base origin/main >/dev/null 2>&1
    rc=$?
    case "$rc" in
        0) ;;
        1)
            warn "push scope violation for #$issue (run: ./scripts/check-push-scope.sh $issue --base origin/main)"
            blocked=1
            ;;
        3)
            warn "CI is already running for this branch; batch review fixes into one push (or PUSH_SCOPE_ALLOW_CI_BUSY=1)"
            blocked=1
            ;;
        *)
            warn "warning: check-push-scope.sh could not run (exit $rc); proceeding"
            ;;
    esac
done

exit "$blocked"
